PORT=4000
MONGO_URL=mongodb://<username>:<password>@<host>/?retryWrites=true&w=majority
# Either name works — CORS_ORIGIN takes priority if both are set.
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=
# Signs staff login tokens — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Password for the one real admin account seeded on first boot (backend/src/db/seed.js) —
# only used if that account doesn't exist yet. Pick a strong password.
ADMIN_SEED_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional — trainee OTP SMS via Fast2SMS. Without this, OTPs just log to the
# console and get returned in the API response (dev mode).
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_MESSAGE_ID=
